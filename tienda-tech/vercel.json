{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "installCommand": "npm install",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/producto/:id", "destination": "/api/feed?page=producto&id=:id" },
    { "source": "/bundles",      "destination": "/bundles.html" },
    { "source": "/relojes",      "destination": "/catalogo.html" },
    { "source": "/auriculares",  "destination": "/catalogo.html" },
    { "source": "/altavoces",    "destination": "/catalogo.html" },
    { "source": "/gaming",       "destination": "/catalogo.html" },
    { "source": "/smartphones",  "destination": "/catalogo.html" },
    { "source": "/garmin",       "destination": "/marca.html" },
    { "source": "/apple",        "destination": "/marca.html" },
    { "source": "/samsung",      "destination": "/marca.html" },
    { "source": "/sony",         "destination": "/marca.html" },
    { "source": "/jbl",          "destination": "/marca.html" },
    { "source": "/jabra",        "destination": "/marca.html" },
    { "source": "/logitech",     "destination": "/marca.html" },
    { "source": "/xiaomi",       "destination": "/marca.html" },
    { "source": "/asus",         "destination": "/marca.html" },
    { "source": "/corsair",      "destination": "/marca.html" },
    { "source": "/sennheiser",   "destination": "/marca.html" },
    { "source": "/motorola",     "destination": "/marca.html" },
    { "source": "/realme",       "destination": "/marca.html" },
    { "source": "/urbanista",    "destination": "/marca.html" },
    { "source": "/alienware",    "destination": "/marca.html" },
    { "source": "/cherry",       "destination": "/marca.html" },
    { "source": "/energy-sistem","destination": "/marca.html" },
    { "source": "/fonestar",     "destination": "/marca.html" },
    { "source": "/forever",      "destination": "/marca.html" },
    { "source": "/genesis",      "destination": "/marca.html" },
    { "source": "/hama",         "destination": "/marca.html" },
    { "source": "/hammer",       "destination": "/marca.html" },
    { "source": "/krom",         "destination": "/marca.html" },
    { "source": "/leotec",       "destination": "/marca.html" },
    { "source": "/mars-gaming",  "destination": "/marca.html" },
    { "source": "/myphone",      "destination": "/marca.html" },
    { "source": "/ngs",          "destination": "/marca.html" },
    { "source": "/phoenix",      "destination": "/marca.html" },
    { "source": "/qcharx",       "destination": "/marca.html" },
    { "source": "/spc",          "destination": "/marca.html" },
    { "source": "/tcl",                         "destination": "/marca.html" },
    { "source": "/smartwatch-running",          "destination": "/caso.html" },
    { "source": "/auriculares-home-office",     "destination": "/caso.html" },
    { "source": "/auriculares-cancelacion-ruido","destination": "/caso.html" },
    { "source": "/auriculares-deporte",         "destination": "/caso.html" },
    { "source": "/altavoz-exterior",            "destination": "/caso.html" },
    { "source": "/teclado-gaming-mecanico",     "destination": "/caso.html" },
    { "source": "/smartphone-5g-barato",        "destination": "/caso.html" },
    { "source": "/smartwatch-salud",            "destination": "/caso.html" },
    { "source": "/smartwatch-mujer",            "destination": "/caso.html" },
    { "source": "/regalo-tecnologico",          "destination": "/caso.html" },
    { "source": "/blog",                         "destination": "/blog/index.html" },
    { "source": "/blog/:slug",                   "destination": "/blog/:slug.html" },
    { "source": "/categoria/:slug",              "destination": "/categoria/:slug.html" },
    { "source": "/nuestra-historia",             "destination": "/nuestra-historia.html" },
    { "source": "/sobre-nosotros",               "destination": "/nuestra-historia.html" },
    { "source": "/nuestra-filosofia",             "destination": "/nuestra-filosofia.html" },
    { "source": "/criterios-seleccion",           "destination": "/nuestra-filosofia.html" },
    { "source": "/contacto",                       "destination": "/contacto.html" }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "zonetechonline.com" }],
      "destination": "https://www.zonetechonline.com/$1",
      "permanent": true
    },
    { "source": "/debug-(.*)", "destination": "/", "permanent": false },
    { "source": "/depau_(.*)", "destination": "/", "permanent": false },
    { "source": "/amazfit_(.*)\\.html", "destination": "/", "permanent": false },
    { "source": "/huawei_(.*)\\.html", "destination": "/", "permanent": false },
    { "source": "/amazon_huawei.html", "destination": "/", "permanent": false },
    { "source": "/mediamarkt_huawei.html", "destination": "/", "permanent": false },
    { "source": "/mm_huawei_all.html", "destination": "/", "permanent": false },
    { "source": "/image-audit-report.json", "destination": "/", "permanent": false },
    { "source": "/upload-log.txt", "destination": "/", "permanent": false },
    { "source": "/enrich-log.txt", "destination": "/", "permanent": false },
    { "source": "/url-mapping.json", "destination": "/", "permanent": false }
  ],
  "crons": [
    { "path": "/api/emails?type=cart-recovery-run", "schedule": "0 8 * * *" }
  ],
  "functions": {
    "api/checkout.js":            { "maxDuration": 15 },
    "api/review.js":              { "maxDuration": 10 },
    "api/emails.js":              { "maxDuration": 10 },
    "api/orders.js":              { "maxDuration": 15 },
    "api/stripe-webhook.js":      { "maxDuration": 15 },
    "api/admin-stats.js":         { "maxDuration": 15 },
    "api/admin-orders.js":        { "maxDuration": 15 },
    "api/admin-products.js":      { "maxDuration": 15 },
    "api/admin-customers.js":     { "maxDuration": 15 },
    "api/ai-assistant.js":          { "maxDuration": 20 },
    "api/megasur.js":             { "maxDuration": 30 },
    "api/feed.js":                { "maxDuration": 15 }
  },
  "headers": [
    {
      "source": "/debug-(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/(depau_.*|amazfit_.*|huawei_.*|amazon_.*|mm_.*|mediamarkt_.*|image-audit-report.json|amazfit_products.json|upload-log.txt|enrich-log.txt|fix-log.txt|puppeteer-log.txt|url-mapping.json)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*\\.ico|.*\\.svg|.*\\.webmanifest|.*\\.png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "X-Frame-Options",           "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "X-XSS-Protection",          "value": "1; mode=block" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",        "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy",   "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://ssl.google-analytics.com https://js.stripe.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.google.com; script-src-elem 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://ssl.google-analytics.com https://js.stripe.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://images.pexels.com https://images.unsplash.com https://cdn2.depau.es https://i.ytimg.com https://www.google-analytics.com https://ssl.google-analytics.com https://www.googletagmanager.com https://stats.g.doubleclick.net https://googleads.g.doubleclick.net https://www.googleadservices.com https://www.google.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://js.stripe.com https://checkout.stripe.com https://bid.g.doubleclick.net; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://api.stripe.com https://googleads.g.doubleclick.net https://www.google.com https://www.googletagmanager.com; object-src 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com; upgrade-insecure-requests;" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "https://www.zonetechonline.com" },
        { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS, GET" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Admin-Key" },
        { "key": "Cache-Control",                "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ]
}
