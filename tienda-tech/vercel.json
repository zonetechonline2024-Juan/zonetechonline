{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/relojes",      "destination": "/catalogo.html" },
    { "source": "/auriculares",  "destination": "/catalogo.html" },
    { "source": "/altavoces",    "destination": "/catalogo.html" },
    { "source": "/gaming",       "destination": "/catalogo.html" },
    { "source": "/smartphones",  "destination": "/catalogo.html" },
    { "source": "/garmin",       "destination": "/marca.html" },
    { "source": "/apple",        "destination": "/marca.html" },
    { "source": "/samsung",      "destination": "/marca.html" },
    { "source": "/sony",         "destination": "/marca.html" },
    { "source": "/jbl",          "destination": "/marca.html" },
    { "source": "/jabra",        "destination": "/marca.html" },
    { "source": "/logitech",     "destination": "/marca.html" },
    { "source": "/xiaomi",       "destination": "/marca.html" },
    { "source": "/asus",         "destination": "/marca.html" },
    { "source": "/corsair",      "destination": "/marca.html" },
    { "source": "/sennheiser",   "destination": "/marca.html" },
    { "source": "/motorola",     "destination": "/marca.html" },
    { "source": "/realme",       "destination": "/marca.html" },
    { "source": "/urbanista",    "destination": "/marca.html" },
    { "source": "/alienware",    "destination": "/marca.html" },
    { "source": "/cherry",       "destination": "/marca.html" },
    { "source": "/energy-sistem","destination": "/marca.html" },
    { "source": "/fonestar",     "destination": "/marca.html" },
    { "source": "/forever",      "destination": "/marca.html" },
    { "source": "/genesis",      "destination": "/marca.html" },
    { "source": "/hama",         "destination": "/marca.html" },
    { "source": "/hammer",       "destination": "/marca.html" },
    { "source": "/krom",         "destination": "/marca.html" },
    { "source": "/leotec",       "destination": "/marca.html" },
    { "source": "/mars-gaming",  "destination": "/marca.html" },
    { "source": "/myphone",      "destination": "/marca.html" },
    { "source": "/ngs",          "destination": "/marca.html" },
    { "source": "/phoenix",      "destination": "/marca.html" },
    { "source": "/qcharx",       "destination": "/marca.html" },
    { "source": "/spc",          "destination": "/marca.html" },
    { "source": "/tcl",                         "destination": "/marca.html" },
    { "source": "/smartwatch-running",          "destination": "/caso.html" },
    { "source": "/auriculares-home-office",     "destination": "/caso.html" },
    { "source": "/auriculares-cancelacion-ruido","destination": "/caso.html" },
    { "source": "/auriculares-deporte",         "destination": "/caso.html" },
    { "source": "/altavoz-exterior",            "destination": "/caso.html" },
    { "source": "/teclado-gaming-mecanico",     "destination": "/caso.html" },
    { "source": "/smartphone-5g-barato",        "destination": "/caso.html" },
    { "source": "/smartwatch-salud",            "destination": "/caso.html" },
    { "source": "/smartwatch-mujer",            "destination": "/caso.html" },
    { "source": "/regalo-tecnologico",          "destination": "/caso.html" }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "zonetechonline.com" }],
      "destination": "https://www.zonetechonline.com/$1",
      "permanent": true
    }
  ],
  "functions": {
    "api/checkout.js":            { "maxDuration": 15 },
    "api/review.js":              { "maxDuration": 10 },
    "api/emails.js":              { "maxDuration": 10 },
    "api/orders.js":              { "maxDuration": 15 },
    "api/stripe-webhook.js":      { "maxDuration": 15 },
    "api/admin-stats.js":         { "maxDuration": 15 },
    "api/admin-orders.js":        { "maxDuration": 15 },
    "api/admin-products.js":      { "maxDuration": 15 },
    "api/admin-customers.js":     { "maxDuration": 15 },
    "api/admin-import-products.js": { "maxDuration": 30 },
    "api/megasur.js":             { "maxDuration": 30 },
    "api/feed.js":                { "maxDuration": 15 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "X-Frame-Options",           "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "X-XSS-Protection",          "value": "1; mode=block" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",        "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "https://www.zonetechonline.com" },
        { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS, GET" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Admin-Key" },
        { "key": "Cache-Control",                "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ]
}
